[Unit]
Description=Xiaofeiyu Kugou Concept API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=kugouapi
Group=kugouapi
WorkingDirectory=/opt/kugou-api
EnvironmentFile=/etc/kugou-api.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/kugou-api/app.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=null
StandardError=null
MemoryMax=220M
UMask=0077
[Install]
WantedBy=multi-user.target
