[Unit]
Description=Xiaofeiyu QQ DeepSeek bridge
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/qq-deepseek
Environment=QQ_BOT_DIR=/opt/qq-deepseek
ExecStart=/usr/bin/python3 /opt/qq-deepseek/bot.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/qq-deepseek
[Install]
WantedBy=multi-user.target
