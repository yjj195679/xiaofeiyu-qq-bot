# Replace /ABSOLUTE/PATH/qq with the actual launcher path installed by NapCat.
# Do not install this template unchanged.
[Unit]
Description=NapCat QQ gateway
After=network-online.target qq-deepseek.service
Wants=network-online.target
[Service]
Type=simple
Environment=HOME=/root
WorkingDirectory=/
ExecStart=/usr/bin/xvfb-run -a /ABSOLUTE/PATH/qq --no-sandbox
Restart=on-failure
RestartSec=10
UMask=0077
[Install]
WantedBy=multi-user.target
